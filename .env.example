# Na primeira execução, a suíte pede host/porta/usuário/senha em /setup
# e cria as tabelas com o usuário admin / admin.
PGHOST=192.168.10.106
PGPORT=35433
PGUSER=admin
PGPASSWORD=admin
PGDATABASE=postgres
SESSION_SECRET=change-me-to-a-long-random-string-32-chars
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin
APP_ADMIN_NAME=Administrator

# Groq (assistente IA no balãozinho de ajuda — opcional)
# Crie a chave em https://console.groq.com/keys
GROQ_API_KEY=
# Modelo atual (llama-3.3-70b-versatile foi desligado em 16/08/2026)
GROQ_MODEL=openai/gpt-oss-20b
